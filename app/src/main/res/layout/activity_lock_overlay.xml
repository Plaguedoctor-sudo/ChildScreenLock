<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Warning / Lock Badge -->
    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/accent_orange" />

    <TextView
        android:id="@+id/tvOverlayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/overlay_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOverlaySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/overlay_subtitle"
        android:textColor="#CBD5E1"
        android:textSize="15sp" />

    <!-- Timer Countdown Badge -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvOverlayTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lock Active: 00:00:00"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoHome"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/secondary"
        android:text="@string/overlay_btn_home"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnParentOverride"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="@string/overlay_btn_parent_override"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:strokeColor="#94A3B8" />

</LinearLayout>
